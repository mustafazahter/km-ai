# Bu dosya yalnız ÖRNEKTİR. Gerçek değerleri .env dosyasına yaz (.env git'e girmez).
# Hızlı yol: scripts/setup.sh (soruları sorar, .env üretir, BRIDGE_TOKEN'ı yerelde üretir).
# Komuta'da sırlar bu dosyadan değil, komuta.yaml `secrets` + güvenli formdan gelir.

STACK_NAME=ai-bot
LOG_LEVEL=info
TZ=Europe/Istanbul
DATA_DIR=data
PLUGINS_DIR=plugins
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# --- Telegram (BotFather'dan) ---
TELEGRAM_BOT_TOKEN=
# Virgüllü sohbet kimlikleri. Boşken bot yalnız /id ve /start'a yanıt verir: önce /id ile öğren.
ALLOWED_CHAT_IDS=

# --- LLM: openrouter | openai | anthropic | gemini | xai | groq | deepseek | mistral | together |
#     perplexity | ollama | lmstudio | vllm | custom (auto = adresten anlaşılır). Panelden de seçilir.
LLM_PROVIDER=auto
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Önerilen: deepseek/deepseek-v4.1-flash-1017 (ucuz, araç çağırır). Boş bırakırsan yerleşik varsayılan openai/gpt-4o-mini kullanılır.
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
# /model komutu için izinli modeller (boş = serbest)
LLM_MODEL_CHOICES=
MAX_TOOL_STEPS=6
LLM_TIMEOUT=60
TURN_TIMEOUT=180
HISTORY_MESSAGES=12

# --- Arama: auto (ücretsiz kanalları sırayla dener) | parallel | duckduckgo | tavily | brave | serper | searxng ---
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
SEARXNG_URL=

# --- Köprü token'ı: tercihen panelde üret (bir kez gösterilir). Env ile de verilebilir ---
BRIDGE_TOKEN=

# Başka bir stack'in araçlarını AI'ya aç (iki parça: adres + token)
# BRIDGE_MT5_URL=https://mt5-trader.example.com
# BRIDGE_MT5_TOKEN=

# Olayları n8n'e gönder (iki parça)
# WEBHOOKS_OUT_URL=https://n8n.example.com/webhook/ai-bot
# WEBHOOKS_OUT_SECRET=

# --- Yönetim arayüzü (/ui) — docs/ARAYUZ.md ---
# Varsayılan: parola. UI_PASSWORD boşsa ilk açılışta günlüğe tek kullanımlık bir kurulum kodu yazılır;
# /ui/setup sayfasında kodla yeni parola belirlenir. Değer verirsen kurulum kodu adımı atlanır.
UI_PASSWORD=
# Kendi kurulum kodun (boşsa rastgele, günlükte):
UI_SETUP_CODE=
# Oturumların yeniden başlatmada düşmemesi için (python -c "import secrets; print(secrets.token_urlsafe(36))")
UI_SESSION_SECRET=
# Komuta kimliği (konsolda "kimlik ilet" açıksa): UI_AUTH=auto (kimlik varsa Komuta, yoksa parola) veya komuta
# UI_AUTH=
# UI_ALLOWED_HOSTS=ai-bot.example.com
# Panel korumasının kapatılmasını tamamen yasaklar:
# UI_FORCE_PROTECTION=1

# --- Köprü / MCP / webhook: varsayılan KAPALI (panel > Entegrasyonlar). Açılışta açmak için:
# BRIDGE_ENABLED=true
# MCP_ENABLED=true
# HOOKS_ENABLED=true

# --- Kanallar (hepsi varsayılan KAPALI; rehber: docs/KANALLAR.md, panelde Kanallar sayfası) ---
# WhatsApp Cloud API (Meta)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Microsoft Teams (Azure Bot Service)
TEAMS_ENABLED=false
TEAMS_APP_ID=
TEAMS_TENANT_ID=
TEAMS_ALLOWED_USERS=
TEAMS_APP_PASSWORD=
# Slack (Events API)
SLACK_ENABLED=false
SLACK_ALLOWED_USERS=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# E-posta (IMAP + SMTP, yalnız TLS)
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_FROM=
EMAIL_ALLOWED_SENDERS=
EMAIL_POLL_SECONDS=60
EMAIL_REQUIRE_AUTH_RESULTS=true
EMAIL_PASSWORD=
